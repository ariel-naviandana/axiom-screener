    },
    {
      "Command": "store",
      "Target": "${!COL2}",
      "Value": "cname",
      "Description": "Kolom 2: nama coin"
    },
    {
      "Command": "end",
      "Target": "",
      "Value": "",
      "Description": "Akhir blok: Baris terbaca?"
    },
    {
      "Command": "executeScript_Sandbox",
      "Target": "return /^[1-9A-HJ-NP-Za-km-z]{32,44}$/.test(String(${ca}).trim()) ? 1 : 0;",
      "Value": "caOk",
      "Description": "1 = CA valid"
    },
    {
      "Command": "if",
      "Target": "${caOk} == 1",
      "Value": "",
      "Description": "CA valid?"
    },
