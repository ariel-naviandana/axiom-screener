{
  "Name": "axiom_watcher",
  "CreationDate": "2026-11-9",
  "Commands": [
    {
      "Command": "comment",
      "Target": "=== CONFIG ===",
      "Value": "",
      "Description": "Bagian pengaturan"
    },
    {
      "Command": "store",
      "Target": "500",
      "Value": "MIN_HOLDERS",
      "Description": "Minimal holder untuk tetap dipantau. Di bawah ini status DROP_HOLDER (dihapus dari watchlist oleh n8n)"
    },
    {
      "Command": "store",
      "Target": "axiom_watchlist.csv",
      "Value": "WATCHLIST_FILE",
      "Description": "File daftar coin yang dipantau (dibuat n8n, kolom: ca,name)"
    },
    {
      "Command": "store",
      "Target": "0",
      "Value": "MAX_COINS",
      "Description": "Batas jumlah coin per run. 0 = semua"
    },
    {
      "Command": "store",
      "Target": "https://axiom.trade/meme/",
      "Value": "AXIOM_MEME_URL",
      "Description": "Awalan alamat halaman detail coin di Axiom"
    },
    {
      "Command": "store",
      "Target": "https://gmgn.ai/sol/token/",
      "Value": "GMGN_TOKEN_URL",
      "Description": "Awalan alamat token GMGN"
    },
    {
      "Command": "store",
      "Target": "axiom_watch.csv",
      "Value": "CSV_FILE",
      "Description": "Nama dasar file hasil (JANGAN mengandung 'axiom_screener')"
    },
    {
      "Command": "executeScript_Sandbox",
      "Target": "var d=new Date();var p=function(n){return ('0'+n).slice(-2)};var base=String(${CSV_FILE}).replace(/\\.csv$/i,'');return base+'_'+d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate())+'_'+p(d.getHours())+'-'+p(d.getMinutes())+'-'+p(d.getSeconds())+'.csv';",
      "Value": "CSV_FILE",
      "Description": "Tambahkan tanggal dan jam ke nama file hasil"
    },
    {
      "Command": "comment",
      "Target": "--- BACA WATCHLIST ---",
      "Value": "",
      "Description": "Hitung jumlah baris watchlist"
    },
    {
      "Command": "store",
      "Target": "0",
      "Value": "maxRow",
      "Description": "Jumlah baris watchlist (termasuk header)"
    },
    {
      "Command": "store",
      "Target": "true",
      "Value": "!errorIgnore",
      "Description": "Mulai blok aman: watchlist boleh belum ada"
    },
    {
      "Command": "store",
      "Target": "true",
      "Value": "!statusOK",
      "Description": "Reset status"
    },
    {
      "Command": "store",
      "Target": "1",
      "Value": "!csvReadLineNumber",
      "Description": "Baca baris 1 (header) untuk tahu jumlah baris"
    },
    {
      "Command": "csvRead",
      "Target": "${WATCHLIST_FILE}",
      "Value": "",
      "Description": "Baca watchlist"
    },
    {
      "Command": "executeScript_Sandbox",
      "Target": "return String(${!statusOK}) === 'true' ? 1 : 0;",
      "Value": "wlOk",
      "Description": "1 = watchlist terbaca"
    },
    {
      "Command": "store",
      "Target": "false",
      "Value": "!errorIgnore",
      "Description": "Akhiri blok aman"
    },
    {
      "Command": "if",
      "Target": "${wlOk} == 1",
      "Value": "",
      "Description": "Watchlist terbaca?"
    },
    {
      "Command": "store",
      "Target": "${!csvReadMaxRow}",
      "Value": "maxRow",
      "Description": "Jumlah baris di watchlist"
    },
    {
      "Command": "end",
      "Target": "",
      "Value": "",
      "Description": "Akhir blok: Watchlist terbaca?"
    },
    {
      "Command": "executeScript_Sandbox",
      "Target": "var m=Number(${maxRow}); var c=Number(${MAX_COINS}); return (c>0 && m>c+1) ? c+1 : m;",
      "Value": "lastLine",
      "Description": "Baris terakhir yang diproses"
    },
    {
      "Command": "executeScript_Sandbox",
      "Target": "return Math.max(0, Number(${lastLine})-1);",
      "Value": "n",
      "Description": "Jumlah coin yang diproses"
    },
    {
      "Command": "echo",
      "Target": "Watchlist: ${n} coin",
      "Value": "blue",
      "Description": "Info jumlah coin"
    },
    {
      "Command": "comment",
      "Target": "--- PROSES TIAP COIN ---",
      "Value": "",
      "Description": "Buka detail Axiom langsung lewat CA, lalu GMGN, tulis satu baris CSV"
    },
    {
      "Command": "store",
      "Target": "2",
      "Value": "line",
      "Description": "Mulai dari baris 2 (baris 1 = header)"
    },
    {
      "Command": "while",
      "Target": "${line} <= ${lastLine}",
      "Value": "",
      "Description": "Proses semua baris watchlist"
    },
    {
      "Command": "store",
      "Target": "x",
      "Value": "ca",
      "Description": "Reset CA"
    },
    {
      "Command": "store",
      "Target": "x",
      "Value": "cname",
      "Description": "Reset nama"
    },
    {
      "Command": "store",
      "Target": "true",
      "Value": "!errorIgnore",
      "Description": "Mulai blok aman: baca baris watchlist"
    },
    {
      "Command": "store",
      "Target": "true",
      "Value": "!statusOK",
      "Description": "Reset status"
    },
    {
      "Command": "store",
      "Target": "${line}",
      "Value": "!csvReadLineNumber",
      "Description": "Baris yang dibaca"
    },
    {
      "Command": "csvRead",
      "Target": "${WATCHLIST_FILE}",
      "Value": "",
      "Description": "Baca satu baris watchlist"
    },
    {
      "Command": "executeScript_Sandbox",
      "Target": "return String(${!statusOK}) === 'true' ? 1 : 0;",
      "Value": "rdOk",
      "Description": "1 = baris terbaca"
    },
    {
      "Command": "store",
