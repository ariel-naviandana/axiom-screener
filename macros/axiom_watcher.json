      "Target": "return String(${ca}).trim();",
      "Value": "ca",
      "Description": "Rapikan CA"
    },
    {
      "Command": "executeScript_Sandbox",
      "Target": "return String(${cname}).replace(/[,\\r\\n\"]/g,' ').trim();",
      "Value": "cname",
      "Description": "Rapikan nama coin"
    },
    {
      "Command": "executeScript_Sandbox",
      "Target": "return Number(${line}) - 1;",
      "Value": "jn",
      "Description": "Nomor coin untuk log"
    },
